<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Past Electricity Bill"
        android:textColor="@color/text_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Past units help the ML model learn your consumption trend"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Month & Year -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Billing Month / Year"
        android:textColor="@color/text_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etBillingMonth"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. October 2026"
        android:inputType="textCapWords"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <!-- Units Consumed -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Units Consumed (kWh)"
        android:textColor="@color/text_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etUnitsConsumed"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. 350"
        android:inputType="numberDecimal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <!-- Bill Amount (PKR) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Total Bill Paid (PKR)"
        android:textColor="@color/text_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etBillPaidPkr"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. 18500"
        android:inputType="numberDecimal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelHistory"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_body" />

        <Button
            android:id="@+id/btnSaveHistory"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_gradient"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Save Record"
            android:textAllCaps="false"
            android:textColor="@color/text_on_orange"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

